{
  "workspace": [
    "./packages/core",
    "./packages/pipeline",
    "./packages/runtime",
    "./extensions/standard",
    "./extensions/http"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno task check:docs && deno test -A",
    "check:docs": "deno run --allow-read=packages,extensions scripts/check_export_docs.ts",
    "test": "deno test -A"
  },
  "fmt": {
    "exclude": [
      "README.md"
    ]
  },
  "lock": false
}
