{
  "workspace": [
    "./packages/core",
    "./packages/pipeline",
    "./packages/runtime",
    "./packages/cli",
    "./extensions/standard",
    "./extensions/http"
  ],
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/yaml": "jsr:@std/yaml@^1"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno task check:docs && deno test -A",
    "check:docs": "deno run --allow-read=packages,extensions scripts/check_export_docs.ts",
    "test": "deno test -A"
  },
  "fmt": {
    "exclude": [
      "README.md",
      "actions"
    ]
  },
  "lock": false
}
