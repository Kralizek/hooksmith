{
  "workspace": [
    "./packages/core",
    "./packages/runtime",
    "./packages/cli",
    "./extensions/standard",
    "./extensions/http"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/yaml": "jsr:@std/yaml@^1",
    "hooksmith-test-extension": "https://raw.githubusercontent.com/Kralizek/hooksmith-test-extension/ceae29a9e8fdb7507e32eed1b87171a4c602c2b2/mod.ts"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno test -A && deno check --config examples/external-extensions/deno.json examples/external-extensions/hooksmith.config.ts",
    "test": "deno test -A"
  },
  "fmt": {
    "exclude": [
      "README.md",
      "actions"
    ]
  },
  "lock": false
}
