{
  "workspace": [
    "./packages/core",
    "./packages/runtime",
    "./packages/cli",
    "./extensions/standard",
    "./extensions/http"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/yaml": "jsr:@std/yaml@^1"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno test -A",
    "test": "deno test -A"
  },
  "fmt": {
    "exclude": [
      "README.md",
      "actions"
    ]
  },
  "lock": false
}
